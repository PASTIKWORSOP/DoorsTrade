function pChats(){
 const ks=Object.keys(db.chats).filter(k=>{const c=ci(k);return c&&(c.buyer==db.me||c.seller==db.me)});
 const asB=ks.filter(k=>ci(k).buyer==db.me),asS=ks.filter(k=>ci(k).buyer!=db.me),list=chatTab=="s"?asB:asS;
 const row=k=>{const c=ci(k),o=chatTab=="s"?c.seller:c.buyer;return `<div class="card" style="cursor:pointer;${k==chatId?"border-color:var(--ac2)":""}" onclick="chatId='${k}';pChats()"><div class="row">${av(o,"s")}<div><b>@${esc(o)}</b><div class="mu">${esc(c.title)}</div></div></div></div>`};
 const c=chatId&&db.chats[chatId]&&ci(chatId);
 const conv=c?`<div class="card"><b>${esc(c.title)}</b><div class="box" id="mb">${db.chats[chatId].map(m=>`<div class="msg ${m.f==db.me?"me":""}">${esc(m.t)}</div>`).join("")}</div><div class="row"><input id="mi" placeholder="Сообщение" style="flex:1;margin:0" onkeydown="if(event.key=='Enter')sendMsg()"><button class="pri" onclick="sendMsg()">➤</button></div></div>`:"";
 $("main").innerHTML=`<h1>Чаты</h1><div class="row"><button class="${chatTab=="s"?"on":""}" onclick="chatTab='s';chatId=null;pChats()">С продавцами (${asB.length})</button><button class="${chatTab=="b"?"on":""}" onclick="chatTab='b';chatId=null;pChats()">С покупателями (${asS.length})</button></div>${list.map(row).join("")||'<div class="card mu">Чатов пока нет. Начните сделку из раздела «Трейды».</div>'}${conv}`;
 const mb=$("mb");if(mb)mb.scrollTop=mb.scrollHeight}
function ci(k){const[t,b]=k.split(":");if(t[0]=="o"){const o=db.orders.find(x=>"o"+x.id==t);return o&&{title:"🛒 Заказ: "+o.item,seller:ADMIN,buyer:b}}const tr=db.trades.find(x=>x.id==t);return tr&&{title:tr.title,seller:tr.by,buyer:b}}
function pChatsOld(){
 const ks=Object.keys(db.chats).filter(k=>{const[t,b]=k.split(":"),tr=db.trades.find(x=>x.id==t);return tr&&(b==db.me||tr.by==db.me)});
 const asBuyer=ks.filter(k=>k.split(":")[1]==db.me),asSeller=ks.filter(k=>k.split(":")[1]!=db.me);
 const list=chatTab=="s"?asBuyer:asSeller;
 const row=k=>{const[t,b]=k.split(":"),tr=db.trades.find(x=>x.id==t),o=chatTab=="s"?tr.by:b;return `<div class="card" style="cursor:pointer;${k==chatId?"border-color:var(--ac2)":""}" onclick="chatId='${k}';pChats()"><div class="row">${av(o,"s")}<div><b>@${esc(o)}</b><div class="mu">${esc(tr.title)}</div></div></div></div>`};
 let conv="";
 if(chatId&&db.chats[chatId]){const[t,b]=chatId.split(":"),tr=db.trades.find(x=>x.id==t);
  conv=tr?`<div class="card"><b>${esc(tr.title)}</b><div class="box" id="mb">${db.chats[chatId].map(m=>`<div class="msg ${m.f==db.me?"me":""}">${esc(m.t)}</div>`).join("")}</div><div class="row"><input id="mi" placeholder="Сообщение" style="flex:1;margin:0" onkeydown="if(event.key=='Enter')sendMsg()"><button class="pri" onclick="sendMsg()">➤</button></div></div>`:""}
 $("main").innerHTML=`<h1>Чаты</h1><div class="row"><button class="${chatTab=="s"?"on":""}" onclick="chatTab='s';chatId=null;pChats()">С продавцами (${asBuyer.length})</button><button class="${chatTab=="b"?"on":""}" onclick="chatTab='b';chatId=null;pChats()">С покупателями (${asSeller.length})</button></div>${list.map(row).join("")||'<div class="card mu">Чатов пока нет. Начните сделку из раздела «Трейды».</div>'}${conv}`;
 const mb=$("mb");if(mb)mb.scrollTop=mb.scrollHeight}
function sendMsg(){const v=$("mi").value.trim();if(!v)return;db.chats[chatId].push({f:db.me,t:v.slice(0,500),ts:Date.now()});save();pChats()}

function pSearch(){
 $("main").innerHTML=`<h1>Искать трейды</h1><div class="card"><input id="fq" placeholder="Поиск: заголовок, предмет или @юзернейм" value="${esc(flt.q)}" oninput="flt.q=this.value;drawList()">
 <div class="row"><div class="sp"><label class="mu">Предмет</label><select onchange="flt.item=this.value;drawList()"><option value="">Все</option>${ALL.map(i=>`<option ${flt.item==i.n?"selected":""}>${i.n}</option>`).join("")}</select></div>
 <div class="sp"><label class="mu">Тип предмета</label><select onchange="flt.cat=this.value;drawList()"><option value="">Все</option>${Object.keys(ITEMS).map(c=>`<option ${flt.cat==c?"selected":""}>${c}</option>`).join("")}</select></div>
 <div class="sp"><label class="mu">Условия</label><select onchange="flt.term=this.value;drawList()"><option value="">Все</option>${TERMS.map(c=>`<option ${flt.term==c?"selected":""}>${c}</option>`).join("")}</select></div>
 <div class="sp"><label class="mu">Гарант</label><select onchange="flt.g=this.value;drawList()"><option value="">Неважно</option><option value="y" ${flt.g=="y"?"selected":""}>С гарантом</option><option value="n" ${flt.g=="n"?"selected":""}>Без гаранта</option></select></div>
 <div class="sp"><label class="mu">Сортировка</label><select onchange="flt.sort=this.value;drawList()"><option value="new">Новые</option><option value="likes" ${flt.sort=="likes"?"selected":""}>По лайкам</option><option value="rate" ${flt.sort=="rate"?"selected":""}>По доверию</option></select></div></div></div><div class="grid" id="tl"></div>`;drawList()}
function drawList(){
 const q=flt.q.trim().toLowerCase().replace(/^@/,"");
 let r=db.trades.filter(t=>!(db.users[t.by]||{}).blocked&&(!q||[t.title,t.by,...t.give,...t.want].join(" ").toLowerCase().includes(q))
  &&(!flt.item||t.give.includes(flt.item)||t.want.includes(flt.item))
  &&(!flt.cat||t.give.some(i=>catOf(i)==flt.cat)||t.want.some(i=>catOf(i)==flt.cat))
  &&(!flt.term||t.term==flt.term)&&(!flt.g||(flt.g=="y")==hasG(t.term)));
 r.sort((a,b)=>flt.sort=="likes"?(b.likes||0)-(a.likes||0):flt.sort=="rate"?rating(b.by).avg-rating(a.by).avg:b.id-a.id);
 $("tl").innerHTML=r.map(tradeCard).join("")||'<div class="card mu">Трейдов не найдено. Станьте первым — добавьте свой!</div>'}

function pAdd(){
 sel={give:[],want:[]};
 const pick=k=>Object.entries(ITEMS).map(([c,a])=>`<div class="cat">${IC[c]} ${c}</div>${a.map(n=>`<span class="chip sel-ch" data-k="${k}" data-n="${n}">${n}</span>`).join("")}`).join("");
 $("main").innerHTML=`<h1>Добавить трейд</h1><div class="card"><label class="mu">Заголовок</label><input id="tt" maxlength="80"><label class="mu">Описание</label><textarea id="td" rows="3" maxlength="500"></textarea><label class="mu">Фото (необязательно)</label><input type="file" id="tp" accept="image/*">
 <label class="mu">Условия</label><select id="tm">${TERMS.map(t=>`<option>${t}</option>`).join("")}</select>
 <h3>🎁 Я отдаю <span class="chip tag" id="c_give">0</span></h3><input class="pf" placeholder="Найти предмет…" oninput="pf(this)"><div onclick="chipClick(event)">${pick("give")}</div><h3>🎯 Хочу получить <span class="chip tag" id="c_want">0</span></h3><input class="pf" placeholder="Найти предмет…" oninput="pf(this)"><div onclick="chipClick(event)">${pick("want")}</div><br><button class="pri" onclick="publish()">Опубликовать</button></div>`}
function chipClick(e){const n=e.target.dataset.n;if(!n)return;const a=sel[e.target.dataset.k],i=a.indexOf(n);i<0?a.push(n):a.splice(i,1);e.target.classList.toggle("sel");$("c_"+e.target.dataset.k).textContent=a.length}
function pf(inp){const q=inp.value.trim().toLowerCase();inp.nextElementSibling.querySelectorAll(".chip").forEach(c=>c.style.display=!q||c.dataset.n.toLowerCase().includes(q)?"":"none")}
function publish(){
 const title=$("tt").value.trim();
 if(!title)return toast("Введите заголовок");
 if(!sel.give.length||!sel.want.length)return toast("Выберите предметы: что отдаёте и что хотите");
 const f=$("tp").files[0];
 const done=photo=>{db.trades.push({id:Date.now(),by:db.me,title,desc:$("td").value.trim(),photo,term:$("tm").value,give:[...sel.give],want:[...sel.want],likes:0});save();toast("Трейд опубликован");go("search")};
 if(!f)return done("");
 const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const c=document.createElement("canvas"),k=Math.min(1,600/im.width);c.width=im.width*k;c.height=im.height*k;c.getContext("2d").drawImage(im,0,0,c.width,c.height);done(c.toDataURL("image/jpeg",.7))};im.src=r.result};r.readAsDataURL(f)}
render();
</script></body></html>
