<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Doors Trade</title>
<style>
:root{--bg:#0b0618;--card:#1a1033cc;--line:#3b2a6b;--tx:#ece6ff;--mu:#a597d6;--ac:#9b5cff;--ac2:#d36bff;--ok:#4ade80;--bad:#f87171;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--tx);background:radial-gradient(ellipse at 20% 0,#2a1160 0,transparent 55%),radial-gradient(ellipse at 90% 100%,#4a0f6b 0,transparent 50%),var(--bg);min-height:100vh}
#stars{position:fixed;inset:0;z-index:-1;background-image:radial-gradient(1px 1px at 20px 30px,#fff,transparent),radial-gradient(1.5px 1.5px at 90px 120px,#d9b8ff,transparent),radial-gradient(1px 1px at 160px 60px,#fff,transparent),radial-gradient(1px 1px at 60px 180px,#c9a6ff,transparent);background-size:200px 200px;opacity:.7}
.wrap{max-width:980px;margin:0 auto;padding:12px}
nav{display:flex;gap:6px;overflow-x:auto;position:sticky;top:env(safe-area-inset-top,0px);background:#0b0618ee;padding:8px 12px;z-index:5;border-bottom:1px solid var(--line);backdrop-filter:blur(8px)}
nav button{white-space:nowrap;flex:0 0 auto}
button,.btn{background:#2a1a55;color:var(--tx);border:1px solid var(--line);border-radius:10px;padding:8px 13px;cursor:pointer;font:inherit}
button:hover{border-color:var(--ac)}button.on,button.pri{background:linear-gradient(135deg,var(--ac),var(--ac2));border-color:transparent;color:#fff}
button:disabled{opacity:.5;cursor:default}
input,textarea,select{width:100%;background:#120a28;color:var(--tx);border:1px solid var(--line);border-radius:10px;padding:9px;font:inherit;margin:4px 0 10px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin:10px 0;box-shadow:0 0 24px #7b3fe433}
h1,h2,h3{margin:.3em 0}h1{background:linear-gradient(90deg,#c9a6ff,#ff8be8);-webkit-background-clip:text;color:transparent}
.mu{color:var(--mu);font-size:.9em}.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.sp{flex:1}
.chip{display:inline-block;background:#2a1a55;border:1px solid var(--line);border-radius:20px;padding:3px 10px;margin:2px;font-size:.85em;cursor:default}
.chip.sel{background:var(--ac);border-color:var(--ac2);color:#fff}.sel-ch{cursor:pointer}
.tag{background:#4a1f8a;color:#e6d5ff}.g{background:#14532d;color:#bbf7d0}
.av{width:56px;height:56px;border-radius:50%;object-fit:cover;background:#2a1a55;border:2px solid var(--ac);display:flex;align-items:center;justify-content:center;font-size:24px;overflow:hidden}
.av.s{width:34px;height:34px;font-size:15px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:10px}
a.u{color:var(--ac2);cursor:pointer;text-decoration:underline}
.msg{max-width:75%;padding:7px 11px;border-radius:12px;margin:4px 0;background:#2a1a55}.msg.me{margin-left:auto;background:#5b2bb3}
.box{max-height:300px;overflow-y:auto}
#toast{position:fixed;bottom:calc(16px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);background:#4a1f8a;border:1px solid var(--ac2);padding:10px 16px;border-radius:12px;z-index:20;display:none;max-width:90%}
.modal{position:fixed;inset:0;background:#000a;display:flex;align-items:center;justify-content:center;z-index:15;padding:14px}.modal .card{max-width:420px;width:100%;background:#1a1033}
.star{font-size:26px;cursor:pointer;color:#555}.star.on{color:#ffd24d}
@keyframes tw{0%,100%{opacity:.4}50%{opacity:1}}
#stars{animation:tw 5s ease-in-out infinite}
#stars::after{content:"";position:absolute;inset:0;background-image:radial-gradient(1px 1px at 50px 90px,#fff,transparent),radial-gradient(2px 2px at 130px 20px,#e9d5ff,transparent);background-size:310px 270px;animation:tw 3s ease-in-out infinite reverse}
nav{box-shadow:0 4px 30px #7b3fe455}
nav button{border-radius:12px;font-weight:500;transition:.2s}
nav button.on{box-shadow:0 0 16px var(--ac)}
.card{transition:.2s;backdrop-filter:blur(6px)}.card:hover{border-color:#6d44c9}
button.pri{box-shadow:0 0 14px #9b5cff66}
.chip{transition:.15s}.chip.sel-ch{cursor:pointer;user-select:none}.chip.sel-ch:hover{border-color:var(--ac2);transform:translateY(-1px)}
.trade{display:flex;gap:8px;align-items:center;margin:10px 0;flex-wrap:wrap}.arrow{font-size:20px;color:var(--ac2)}
.side{flex:1;min-width:130px;background:#120a2888;border:1px solid var(--line);border-radius:10px;padding:8px}
.cat{margin:12px 0 2px;color:var(--ac2);font-weight:600;font-size:.9em;letter-spacing:.04em}
.pf{margin:4px 0 6px}
.scam{background:#b91c1c;border-color:#ef4444;color:#fff}.scam:hover{background:#dc2626}
.mhead{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;display:flex;align-items:center;padding:10px 14px;background:#0b0618ee;border-bottom:1px solid var(--line);backdrop-filter:blur(8px)}
.mnav{position:fixed;left:0;right:0;bottom:0;z-index:6;display:flex;background:#0b0618f7;border-top:1px solid var(--line);padding:6px 4px calc(6px + env(safe-area-inset-bottom,0px));box-shadow:0 -4px 24px #7b3fe444}
.mnav button{flex:1;border:none;background:none;font-size:.68em;display:flex;flex-direction:column;align-items:center;gap:2px;padding:4px 0;color:var(--mu)}
.mnav button.on{color:#fff}.mnav .ic{font-size:22px}
.mnav button.plus .ic{background:linear-gradient(135deg,var(--ac),var(--ac2));border-radius:50%;width:46px;height:46px;display:flex;align-items:center;justify-content:center;margin-top:-18px;box-shadow:0 0 16px var(--ac)}
body.m .grid{grid-template-columns:1fr}body.m input,body.m textarea,body.m select{font-size:16px}
body.m button{min-height:42px}body.m .mnav button{min-height:0}body.m .wrap{padding:10px}
body.m #toast{bottom:calc(84px + env(safe-area-inset-bottom,0px))}body.m h1{font-size:1.5em}
</style></head><body><div id="stars"></div><div id="app"></div><div id="toast"></div>
<script>
const ITEMS={"Свет":["Зажигалка","Фонарик","Большой фонарик","Фонарик-эспандер","Свеча","Свеча лунного света","Светящаяся палочка"],"Лечение":["Пластырь","Упаковка пластырей","Витамины"],"Батарейки":["Батарейка","Упаковка батареек"],"Отмычки":["Отмычка","Отмычка-скелет"],"Защита":["Распятие"],"Звёздный свет":["Флакон звездного света","Бутылка звездного света (большая колба)","Кувшин звездного света (бочка)"],"Банки":["Банка для чаевых","Банка Разлома"],"Прочее":["Лотус","Чемодан","Ланч-бокс"],"Сканер":["Сканер","Модуль сканера: Монстр","Модуль сканера: Перевод","Модуль сканера: Фонарик","Модуль сканера: Мини-игра"]};
const IC={"Свет":"🔦","Лечение":"🩹","Батарейки":"🔋","Отмычки":"🗝️","Защита":"✝️","Звёздный свет":"✨","Банки":"🫙","Прочее":"🧳","Сканер":"📡"};
const ALL=Object.entries(ITEMS).flatMap(([c,a])=>a.map(n=>({n,c})));
const catOf=n=>(ALL.find(i=>i.n==n)||{}).c;
const TERMS=["Договорный","Гарант","Покупатель первый","Гарант человек"];
const hasG=t=>t=="Гарант"||t=="Гарант человек";
let db;try{db=JSON.parse(localStorage.getItem("doorsx"))}catch(e){}
db=db||{users:{},trades:[],deals:[],chats:{},reviews:[],tickets:[],me:null};db.tickets=db.tickets||[];
const ADMIN="kvapl"; /* юзернейм администратора */
const save=()=>{try{localStorage.setItem("doorsx",JSON.stringify(db))}catch(e){toast("Не удалось сохранить данные")}};
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const $=id=>document.getElementById(id);
const me=()=>db.users[db.me];
let tab="profile",view=null,pending=null,sel={give:[],want:[]},flt={q:"",item:"",cat:"",term:"",g:"",sort:"new"},chatId=null,chatTab="s";
function toast(t){const e=$("toast");e.textContent=t;e.style.display="block";clearTimeout(toast.t);toast.t=setTimeout(()=>e.style.display="none",3500)}
const av=(u,s)=>{const x=db.users[u];return x&&x.avatar?`<img class="av ${s||""}" src="${x.avatar}">`:`<div class="av ${s||""}">👤</div>`};
function rating(u){const r=db.reviews.filter(r=>r.to==u);if(!r.length)return{n:0,avg:0,pct:0};const a=r.reduce((s,x)=>s+x.stars,0)/r.length;return{n:r.length,avg:a,pct:Math.round(a/5*100)}}
const trust=u=>{const r=rating(u);return r.n?`<span class="chip g">🛡 Доверие ${r.pct}% · ★${r.avg.toFixed(1)} (${r.n})</span>`:`<span class="chip">🛡 Нет отзывов</span>`};
const hash=s=>btoa(unescape(encodeURIComponent(s)));

function render(){
 document.body.classList.toggle("m",isMob());if(!UI)return uiPick();
 if(db.me&&(!db.users[db.me]||db.users[db.me].blocked)){db.me=null;save();toast("Аккаунт недоступен")}
 if(!db.me)return auth();
 const T=[["profile","👤 Профиль"],["hist","📜 История"],["shop","🛒 Shop"],["plus","💎 Trader+"],["games","🎮 Мини-игры"],["chats","💬 Чаты"],["search","🔎 Трейды"],["add","➕ Добавить"]];
 if(db.me==ADMIN)T.push(["admin","🛡 Админ"+((c=>c?" ("+c+")":"")(db.tickets.filter(t=>t.status=="open").length+db.orders.filter(o=>o.status=="new").length))]);
 $("app").innerHTML=(window.curT=T,document.body.classList.toggle("m",isMob()),isMob()?mobUI(T):deskUI(T));
 ({profile:pProfile,hist:pHist,shop:pShop,games:pGames,plus:pPlus,chats:pChats,search:pSearch,add:pAdd,admin:pAdmin})[tab]();
}
function go(t){clearInterval(window.gi);tab=t;view=null;render();scrollTo(0,0)}
let mode="login";
function auth(){
 if(pending){$("app").innerHTML=`<div class="wrap"><div class="card"><h2>Подтверждение почты</h2><p class="mu">Введите 6-значный код для ${esc(pending.email)}.</p><p class="chip tag">Демо-режим: код ${pending.code} (отправка писем требует сервера)</p><input id="vc" placeholder="Код" maxlength="6" inputmode="numeric"><button class="pri" onclick="verify()">Подтвердить</button> <button onclick="pending=null;render()">Назад</button></div></div>`;return}
 const reg=mode=="reg";
 $("app").innerHTML=`<div class="wrap" style="max-width:420px;padding-top:6vh"><h1 style="font-size:2.2em;text-align:center">🚪 DOORS TRADE</h1><p class="mu" style="text-align:center">Площадка трейдов Roblox Doors</p><div class="card">
 <div class="row"><button class="${reg?"":"on"}" onclick="mode='login';render()">Вход</button><button class="${reg?"on":""}" onclick="mode='reg';render()">Регистрация</button></div><br>
 ${reg?`<label class="mu">Никнейм</label><input id="nn"><label class="mu">Юзернейм (по нему ищут)</label><input id="un" placeholder="латиница, цифры, _"><label class="mu">Почта</label><input id="em" type="email">`:`<label class="mu">Никнейм</label><input id="un">`}
 <label class="mu">Пароль</label><input id="pw" type="password"><button class="pri" style="width:100%" onclick="${reg?"register()":"login()"}">${reg?"Создать аккаунт":"Войти"}</button></div></div>`}
function register(){
 const nn=$("nn").value.trim(),un=$("un").value.trim().toLowerCase(),em=$("em").value.trim(),pw=$("pw").value;
 if(!nn||!/^[a-z0-9_]{3,20}$/.test(un))return toast("Юзернейм: 3–20 символов, a-z, 0-9, _");
 if(!/^\S+@\S+\.\S+$/.test(em))return toast("Неверная почта");
 if(pw.length<6)return toast("Пароль минимум 6 символов");
 if(db.users[un])return toast("Юзернейм занят");
 if(Object.values(db.users).some(x=>x.nick.toLowerCase()==nn.toLowerCase()))return toast("Ник занят");
 pending={nn,un,em,pw,code:String(Math.floor(100000+Math.random()*900000))};render()}
function verify(){
 if($("vc").value.trim()!=pending.code)return toast("Неверный код");
 const p=pending;db.users[p.un]={nick:p.nn,user:p.un,email:p.em,pw:hash(p.pw),bio:"",avatar:"",follows:[],likes:[],stars:0,promos:[],created:Date.now()};
 db.me=p.un;pending=null;save();tab="profile";render()}
function login(){
 const nv=$("un").value.trim().toLowerCase(),u=Object.values(db.users).find(x=>x.nick.toLowerCase()==nv);
 if(!u||u.pw!=hash($("pw").value))return toast("Неверный юзернейм или пароль");
 if(u.blocked)return toast("Аккаунт заблокирован администратором");
 db.me=u.user;save();render()}

function pProfile(){
 const u=view||db.me,x=db.users[u];if(!x){view=null;return pProfile()}
 const mine=u==db.me,fol=Object.values(db.users).filter(a=>a.follows.includes(u)).length;
 const revs=db.reviews.filter(r=>r.to==u).reverse();
 $("main").innerHTML=`<div class="card"><div class="row">${av(u)}<div><h2>${esc(x.nick)}</h2><div class="mu">@${esc(u)} · ${fol} подписчиков · ${x.follows.length} подписок</div></div><span class="sp"></span>
 ${mine?"":`<button class="${me().follows.includes(u)?"on":""}" onclick="follow('${u}')">${me().follows.includes(u)?"✓ Вы подписаны":"+ Подписаться"}</button>`}</div>
 <p>${esc(x.bio)||'<span class="mu">Описание не указано</span>'}</p>${trust(u)}</div>
 ${mine?`<div class="card"><h3>Редактировать профиль</h3><label class="mu">Никнейм</label><input id="enn" value="${esc(x.nick)}"><label class="mu">Юзернейм</label><input id="eun" value="${esc(x.user)}"><label class="mu">Описание</label><textarea id="ebio" rows="3" maxlength="300">${esc(x.bio)}</textarea><label class="mu">Аватарка</label><input type="file" id="eav" accept="image/*"><button class="pri" onclick="saveProf()">Сохранить</button></div>`:""}
 <div class="card"><h3>Отзывы (${revs.length})</h3>${revs.map(r=>`<div style="margin:8px 0"><b><a class="u" onclick="view='${r.from}';pProfile()">@${esc(r.from)}</a></b> <span style="color:#ffd24d">${"★".repeat(r.stars)}</span><div>${esc(r.text)}</div></div>`).join("")||'<span class="mu">Пока нет отзывов</span>'}</div>
 <h3>Трейды пользователя</h3><div class="grid">${db.trades.filter(t=>t.by==u).map(tradeCard).join("")||'<span class="mu">Нет трейдов</span>'}</div>`}
function follow(u){const f=me().follows,i=f.indexOf(u);i<0?f.push(u):f.splice(i,1);save();render2()}
function render2(){tab=="profile"?pProfile():render()}
function saveProf(){
 const nu=$("eun").value.trim().toLowerCase(),old=db.me;
 if(!/^[a-z0-9_]{3,20}$/.test(nu))return toast("Неверный юзернейм");
 if(nu!=old&&db.users[nu])return toast("Юзернейм занят");
 const nk=$("enn").value.trim();if(nk.toLowerCase()!=db.users[old].nick.toLowerCase()&&Object.values(db.users).some(x=>x.nick.toLowerCase()==nk.toLowerCase()))return toast("Ник занят");
 const x=db.users[old];x.nick=$("enn").value.trim()||x.nick;x.bio=$("ebio").value;
 const f=$("eav").files[0];
 const fin=()=>{if(nu!=old)renameUser(old,nu);save();view=null;render();toast("Сохранено")};
 if(!f)return fin();
 const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const c=document.createElement("canvas");c.width=c.height=128;const g=c.getContext("2d"),s=Math.min(im.width,im.height);g.drawImage(im,(im.width-s)/2,(im.height-s)/2,s,s,0,0,128,128);x.avatar=c.toDataURL("image/jpeg",.8);fin()};im.src=r.result};r.readAsDataURL(f)}
function renameUser(a,b){
 const x=db.users[a];delete db.users[a];x.user=b;db.users[b]=x;db.me=b;
 Object.values(db.users).forEach(u=>u.follows=u.follows.map(f=>f==a?b:f));
 db.trades.forEach(t=>{if(t.by==a)t.by=b});db.deals.forEach(d=>{if(d.buyer==a)d.buyer=b;if(d.seller==a)d.seller=b});
 db.reviews.forEach(r=>{if(r.from==a)r.from=b;if(r.to==a)r.to=b});
 const nc={};for(const[k,v]of Object.entries(db.chats)){const[t,bu]=k.split(":");nc[bu==a?t+":"+b:k]=v.map(m=>({...m,f:m.f==a?b:m.f}))}db.chats=nc}

function tradeCard(t){
 const liked=me().likes.includes(t.id),own=t.by==db.me;
 return `<div class="card"><h3>${esc(t.title)}</h3><div class="row mu">${av(t.by,"s")}<a class="u" onclick="view='${t.by}';tab='profile';render()">@${esc(t.by)}</a>${trust(t.by)}</div>
 <p>${esc(t.desc)}</p>${t.photo?`<img src="${t.photo}" style="max-width:100%;border-radius:10px">`:""}
 <div class="trade"><div class="side"><b>🎁 Отдаёт</b><br>${t.give.map(i=>`<span class="chip">${esc(i)}</span>`).join("")}</div><div class="arrow">⇄</div>
 <div class="side"><b>🎯 Хочет</b><br>${t.want.map(i=>`<span class="chip">${esc(i)}</span>`).join("")}</div></div>
 <div class="row" style="margin-top:8px"><span class="chip ${hasG(t.term)?"g":"tag"}">${esc(t.term)}</span><span class="sp"></span>
 <button onclick="like(${t.id})">${liked?"❤️":"🤍"} ${t.likes||0}</button>
 ${own?`<button onclick="delTrade(${t.id})">Удалить</button>`:`<button class="pri" onclick="startDeal(${t.id})">Предложить сделку</button>`}</div></div>`}
function like(id){const t=db.trades.find(x=>x.id==id),l=me().likes,i=l.indexOf(id);if(i<0){l.push(id);t.likes=(t.likes||0)+1}else{l.splice(i,1);t.likes--}save();render2b()}
function render2b(){tab=="search"?pSearch():tab=="profile"?pProfile():render()}
function delTrade(id){db.trades=db.trades.filter(t=>t.id!=id);save();render2b()}
function startDeal(id){
 const t=db.trades.find(x=>x.id==id);
 if(db.deals.some(d=>d.tradeId==id&&d.buyer==db.me&&d.status=="pending"))return toast("Сделка уже предложена");
 db.deals.push({id:Date.now(),tradeId:id,buyer:db.me,seller:t.by,status:"pending"});
 const k=id+":"+db.me;(db.chats[k]=db.chats[k]||[]).push({f:db.me,t:"Здравствуйте! Хочу обменяться по трейду «"+t.title+"».",ts:Date.now()});
 save();toast("Сделка предложена, чат создан");chatId=k;chatTab="s";go("chats")}

function pHist(){
 const ds=db.deals.filter(d=>d.buyer==db.me||d.seller==db.me).reverse();
 const sec=(t,f)=>`<h3>${t}</h3>${ds.filter(f).map(dealRow).join("")||'<div class="mu">Пусто</div>'}`;
 $("main").innerHTML=`<h1>История трейдов</h1>${sec("⏳ Ожидание",d=>d.status=="pending")}${sec("🔄 В процессе (принятые)",d=>d.status=="accepted")}${sec("✅ Завершённые",d=>d.status=="done")}${sec("🚨 Scam",d=>d.status=="scam")}${sec("❌ Отклонённые",d=>d.status=="declined")}`}
function dealRow(d){
 const t=db.trades.find(x=>x.id==d.tradeId),other=d.buyer==db.me?d.seller:d.buyer,mineSeller=d.seller==db.me;
 const rv=db.reviews.some(r=>r.deal==d.id&&r.from==db.me);
 return `<div class="card"><div class="row"><b>${esc(t?t.title:"Трейд удалён")}</b><span class="sp"></span><span class="mu">с <a class="u" onclick="view='${other}';tab='profile';render()">@${esc(other)}</a></span></div>
 <div class="row" style="margin-top:8px">${d.status=="pending"&&mineSeller?`<button class="pri" onclick="setDeal(${d.id},'accepted')">Принять</button><button onclick="setDeal(${d.id},'declined')">Отклонить</button>`:""}
 ${d.status=="pending"&&!mineSeller?`<span class="mu">Ждём ответа продавца</span><button onclick="setDeal(${d.id},'declined')">Отменить</button>`:""}
 ${d.status=="accepted"?(mineSeller?'<span class="mu">Сделка принята. Ждём подтверждения покупателя после трейда</span>':`<button class="pri" onclick="setDeal(${d.id},'done')">✅ Трейд прошёл успешно</button><button class="scam" onclick="scamModal(${d.id},'${other}')">🚨 Scam</button>`):""}${d.status=="done"?(rv?'<span class="mu">Отзыв оставлен ✓</span>':`<button class="pri" onclick="reviewModal(${d.id},'${other}')">Оставить отзыв</button>`):""}${d.status=="scam"?'<span class="chip" style="background:#7f1d1d">🚨 Тикет отправлен администратору</span>':""}</div></div>`}
